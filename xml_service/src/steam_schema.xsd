<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="GameComplianceReport">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Configuration">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="DataSource">
                <xs:complexType>
                  <xs:attribute name="Name" type="xs:string" use="required"/>
                  <xs:attribute name="LastSync" type="xs:dateTime" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="ValidatedBy" type="xs:string" use="required"/>
            <xs:attribute name="Requester" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="Catalog">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Game" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ProductDetails">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Title" type="xs:string"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="FinancialData">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="CurrentPrice">
                            <xs:complexType>
                              <xs:simpleContent>
                                <xs:extension base="xs:string">
                                  <xs:attribute name="Currency" type="xs:string" use="required"/>
                                </xs:extension>
                              </xs:simpleContent>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="PopularityMetrics">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ReviewCount" type="xs:integer"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="InternalID" type="xs:string" use="required"/>
                  <xs:attribute name="ReleaseYear" type="xs:integer" use="required"/>
                  <xs:attribute name="Genre" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="GenerationDate" type="xs:date" use="required"/>
      <xs:attribute name="Version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>